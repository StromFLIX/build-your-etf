<ss:Worksheet ss:Name="Überblick">
<ss:Table>
<ss:Row >
<ss:Cell ss:StyleID="headerstyle">
<ss:Data ss:Type="String">iShares Bitcoin ETP</ss:Data>
</ss:Cell>
</ss:Row>
<ss:Row/>
<ss:Row ss:Height="50">
<ss:Cell ss:MergeAcross="11" ss:StyleID="wraptext">
<ss:Data ss:Type="String">Die vom ETP gehaltenen Wertpapiere sollen ein Engagement im Bitcoin bieten, wobei jedes der Wertpapier im ETP einer bestimmten Menge an Bitcoins entspricht (sogenanntes Cryptoasset-Entitlement).</ss:Data>
</ss:Cell>
