<ss:Worksheet ss:Name="Überblick">
<ss:Table>
<ss:Row >
<ss:Cell ss:StyleID="headerstyle">
<ss:Data ss:Type="String">iShares European Property Yield UCITS ETF</ss:Data>
</ss:Cell>
</ss:Row>
<ss:Row/>
<ss:Row ss:Height="50">
<ss:Cell ss:MergeAcross="11" ss:StyleID="wraptext">
<ss:Data ss:Type="String">Der Fonds strebt die Nachbildung der Wertentwicklung eines Index an, der aus börsennotierten Immobiliengesellschaften und Real Estate Investment Trusts (REIT) von europäischen Industrieländern außer dem Vereinigten Königreich besteht, die auch die Kriterien für die Dividendenrendite erfüllen.</ss:Data>
</ss:Cell>
</ss:Row>
<ss:Row/>
