<ss:Row >
<ss:Cell ss:StyleID="headerstyle">
<ss:Data ss:Type="String">iShares MSCI World Consumer Discretionary Sector Advanced UCITS ETF</ss:Data>
</ss:Cell>
</ss:Row>
<ss:Row/>
<ss:Row ss:Height="50">
<ss:Cell ss:MergeAcross="11" ss:StyleID="wraptext">
<ss:Data ss:Type="String">Der Fonds strebt durch eine Kombination aus Kapitalzuwachs und Erträgen aus dem Fondsvermögen die Erzielung einer Gesamtrendite auf Ihre Anlage an, die die Rendite des MSCI World Consumer Discretionary Advanced Select 20 35 Capped Index widerspiegelt.</ss:Data>
</ss:Cell>
</ss:Row>
