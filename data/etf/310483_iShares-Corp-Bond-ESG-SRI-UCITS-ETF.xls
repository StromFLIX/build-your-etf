<ss:Data ss:Type="String">iShares $ Corp Bond ESG SRI​ UCITS ETF</ss:Data>
</ss:Cell>
</ss:Row>
<ss:Row/>
<ss:Row ss:Height="50">
<ss:Cell ss:MergeAcross="11" ss:StyleID="wraptext">
<ss:Data ss:Type="String">Der Fonds ist bestrebt, die Wertentwicklung eines Index nachzubilden, der sich aus ESG-überprüften Unternehmensanleihen (umweltverträgliche, soziale und gute Unternehmensführung) zusammensetzt, die auf USD lauten.</ss:Data>
</ss:Cell>
</ss:Row>
