<ss:Table>
<ss:Row >
<ss:Cell ss:StyleID="headerstyle">
<ss:Data ss:Type="String">iShares $ High Yield Corp Bond ESG Paris-Aligned Climate UCITS ETF</ss:Data>
</ss:Cell>
</ss:Row>
<ss:Row/>
<ss:Row ss:Height="50">
<ss:Cell ss:MergeAcross="11" ss:StyleID="wraptext">
<ss:Data ss:Type="String">Der Fonds strebt unter Berücksichtigung von Kapital- und Zinserträgen die Erzielung einer Rendite auf Ihre Anlage an, welche die Rendite des Bloomberg MSCI US Corporate High Yield Climate Paris-Aligned ESG Select Index widerspiegelt.</ss:Data>
</ss:Cell>
</ss:Row>
